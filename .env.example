# ==========================================
# Application & Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=mydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your_secure_postgres_password@localhost:5432/mydb?schema=public"

# ==========================================
# Redis & Cache Configuration
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=3600

# ==========================================
# MongoDB Analytics Configuration
# ==========================================
MONGO_URI=mongodb://admin:adminpassword@localhost:27017/logpose_analytics?authSource=admin
MONGO_DB=logpose_analytics
MONGO_USER=admin
MONGO_PASSWORD=adminpassword
MONGO_PORT=27017
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# ==========================================
# JWT Authentication Configuration
# Generate a 256-bit secret via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
JWT_SECRET=your_jwt_secret_minimum_32_bytes_hex_string
JWT_EXPIRES_IN=604800
JWT_ISSUER=logpose

# ==========================================
# Argon2 Password Hashing Configuration
# Generate a secret pepper via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
PASSWORD_PEPPER=your_argon2_password_pepper_32_bytes_hex
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# ==========================================
# Format-Preserving Encryption (FF1) & Base62
# Generate a 128-bit AES key via: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ==========================================
BASE62_KEY=your_16_byte_aes_key_in_hex_32_chars
BASE62_TWEAK=your_optional_tweak_hex_or_empty

# ==========================================
# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==========================================
# Background Scheduler & Worker Tasks
# ==========================================
ANALYTICS_RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_MS=3600000
URL_EXPIRY_INTERVAL_MS=300000
SUBSCRIPTION_RECONCILE_INTERVAL_MS=60000

# ==========================================
# Kafka Stream Configuration
# ==========================================
KAFKA_BROKER=localhost:9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=logpose-api
KAFKA_CLICK_TOPIC=url-clicks
KAFKA_TOPIC_CLICKS=url-clicks
KAFKA_GROUP_ID=analytics-stream-consumers
KAFKA_CONNECTION_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_MAX_RETRIES=5
STREAM_BATCH_SIZE=500
STREAM_FLUSH_INTERVAL_MS=2000

# ==========================================
# Razorpay Payment & Subscription Configuration
# Obtain credentials from Razorpay Dashboard -> Settings -> API Keys & Webhooks
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
