# ==========================================
# Application & Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=mydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your_secure_postgres_password@localhost:5432/mydb?schema=public"

# ==========================================
# Redis & Cache Configuration
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=3600

# ==========================================
# JWT Authentication Configuration
# Generate a 256-bit secret via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
JWT_SECRET=your_jwt_secret_minimum_32_bytes_hex_string
JWT_EXPIRES_IN=604800
JWT_ISSUER=logpose

# ==========================================
# Argon2 Password Hashing Configuration
# Generate a secret pepper via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
PASSWORD_PEPPER=your_argon2_password_pepper_32_bytes_hex
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# ==========================================
# Format-Preserving Encryption (FF1) & Base62
# Generate a 128-bit AES key via: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ==========================================
BASE62_KEY=your_16_byte_aes_key_in_hex_32_chars
BASE62_TWEAK=your_optional_tweak_hex_or_empty

# ==========================================
# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==========================================
# Background Scheduler & Worker Tasks
# ==========================================
ANALYTICS_RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_MS=3600000
URL_EXPIRY_INTERVAL_MS=300000
