# ==========================================
# Production Application & Server Configuration
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# Production PostgreSQL Database Configuration
# In production, use high-entropy credentials and managed host (e.g. AWS RDS, GCP Cloud SQL)
# ==========================================
POSTGRES_USER=logpose_prod
POSTGRES_PASSWORD=generate_strong_production_db_password
POSTGRES_DB=logpose_prod_db
POSTGRES_HOST=postgres.production.internal
POSTGRES_PORT=5432
DATABASE_URL="postgresql://logpose_prod:generate_strong_production_db_password@postgres.production.internal:5432/logpose_prod_db?schema=public&sslmode=require"

# ==========================================
# Production Redis & Caching Configuration
# ==========================================
REDIS_URL=rediss://default:strong_redis_password@redis.production.internal:6379
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=strong_redis_password
REDIS_DEFAULT_TTL=3600

# ==========================================
# Production JWT Authentication Configuration
# MUST be 64-character hex string generated with crypto.randomBytes(32).toString('hex')
# ==========================================
JWT_SECRET=generate_strong_production_jwt_secret_32_bytes_hex
JWT_EXPIRES_IN=604800
JWT_ISSUER=logpose

# ==========================================
# Production Argon2 Password Hashing Configuration
# MUST be 64-character hex string generated with crypto.randomBytes(32).toString('hex')
# ==========================================
PASSWORD_PEPPER=generate_strong_production_pepper_32_bytes_hex
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# ==========================================
# Format-Preserving Encryption (FF1) & Base62
# 128-bit AES hex key (32 hex characters)
# ==========================================
BASE62_KEY=generate_16_byte_aes_key_in_hex_32_chars
BASE62_TWEAK=generate_optional_tweak_hex_or_empty

# ==========================================
# Google OAuth 2.0 Credentials (Production)
# Configure production redirect URI with HTTPS
# ==========================================
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# ==========================================
# Production Scheduler & Worker Tasks
# ==========================================
ANALYTICS_RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_MS=3600000
URL_EXPIRY_INTERVAL_MS=300000
